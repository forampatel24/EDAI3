# Frontend ngrok configuration
# Copy this to .env.local or .env and fill in your ngrok URLs

# Your ngrok HTTPS URL for the backend (e.g., https://abc123.ngrok-free.app)
VITE_API_URL=https://your-backend-ngrok-url.ngrok-free.app

# Optional: If your frontend is also behind ngrok, set this for websocket/HMR
# VITE_DEV_SERVER_URL=https://your-frontend-ngrok-url.ngrok-free.app