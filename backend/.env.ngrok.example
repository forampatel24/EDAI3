# Backend ngrok configuration
# Copy this to .env and fill in your ngrok URLs

# Comma-separated list of allowed frontend origins
# Include your ngrok frontend URL(s) and localhost for local dev
CORS_ORIGINS=https://your-frontend-ngrok-url.ngrok-free.app,http://localhost:5173,http://127.0.0.1:5173

# Database (default SQLite)
DATABASE_URL=sqlite:///edai3.db

# Upload directory
UPLOAD_DIR=uploads

# ChromaDB directory
CHROMA_DIR=chroma_db

# JWT Secret (auto-generated if not set, persisted in .jwt_secret)
# SECRET_KEY=your-secret-key-here

# LLM Provider: gemini | groq | openai
LLM_PROVIDER=gemini

# API Keys (set the one for your chosen provider)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Models (defaults shown)
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-flash-latest
GROQ_MODEL=openai/gpt-oss-20b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2